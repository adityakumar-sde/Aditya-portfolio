# ==============================================================================
# Aditya Raj Portfolio - Environment Variables Template
# Copy this file to '.env' and fill in your environment-specific values.
# NEVER commit the actual '.env' file containing real credentials to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION ENVIRONMENT & GENERAL SETTINGS
# ------------------------------------------------------------------------------
NODE_ENV=development
APP_NAME="Aditya Raj | Portfolio & Architecture Kernel"
PORTFOLIO_VERSION=2.4.0

# ------------------------------------------------------------------------------
# 2. SERVER & FRONTEND PORTS
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8080
MYSQL_PORT=3306

# ------------------------------------------------------------------------------
# 3. BACKEND (Spring Boot) DATABASE CONFIGURATION
# ------------------------------------------------------------------------------
# In Docker Compose, host is 'mysql'; for local development, host is 'localhost'
DB_HOST=mysql
DB_PORT=3306
DB_NAME=portfolio_db
DB_USERNAME=portfolio_user
DB_PASSWORD=portfolio_pass_secret
DB_ROOT_PASSWORD=portfolio_root_supersecret

# Spring Boot Datasource URL
# Local Dev (H2 in-memory default):
# DB_URL=jdbc:h2:mem:portfoliodb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE
# MySQL Production / Docker:
DB_URL=jdbc:mysql://${DB_HOST}:${DB_PORT}/${DB_NAME}?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC

# JPA / Hibernate DDL behavior: validate | update | create | create-drop
JPA_DDL_AUTO=update

# ------------------------------------------------------------------------------
# 4. ADMIN CONSOLE AUTHENTICATION
# ------------------------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_to_secure_password
JWT_SECRET=super_secret_jwt_signing_key_replace_in_production_min_256_bits_123456
JWT_EXPIRATION_MS=86400000

# ------------------------------------------------------------------------------
# 5. LLM / AI LAB ASSISTANT CONFIGURATION
# ------------------------------------------------------------------------------
# Optional: Provide OpenAI or Gemini API key for the AI engineering chatbot
LLM_API_KEY=your_llm_api_key_here
LLM_MODEL=gpt-4o-mini

# ------------------------------------------------------------------------------
# 6. FRONTEND (Vite) PUBLIC ENVIRONMENT VARIABLES
# (Must be prefixed with VITE_ to be exposed to the client bundle)
# ------------------------------------------------------------------------------
VITE_API_BASE_URL=/api
VITE_APP_TITLE="Aditya Raj | Engineering Portfolio"
VITE_DEV_MODE=true
VITE_ENABLE_TERMINAL=true
